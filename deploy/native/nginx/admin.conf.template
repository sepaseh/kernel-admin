map $uri $kernel_admin_cache_control {
    default "no-store";
    ~^${VITE_APP_BASE_URL}assets/ "public, max-age=31536000, immutable";
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${ADMIN_HOST};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location / { return 308 https://$host:${HTTPS_PORT}$request_uri; }
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_HOST};
    ssl_certificate ${TLS_CERTIFICATE};
    ssl_certificate_key ${TLS_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    root ${ADMIN_ROOT};
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' ${CONNECT_SOURCES}; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob: ${VITE_API_BASE_URL} ${PUBLIC_ASSET_ORIGIN}; media-src 'self' blob: ${VITE_API_BASE_URL} ${PUBLIC_ASSET_ORIGIN}; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control $kernel_admin_cache_control always;

    location = ${VITE_APP_BASE_URL}_kernel/release {
        default_type application/json;
        try_files $uri.json =404;
    }
    location ^~ ${VITE_APP_BASE_URL}assets/ {
        try_files $uri =404;
    }
    location ~ /\. { return 404; }
    location ${VITE_APP_BASE_URL} {
        try_files $uri $uri/ ${VITE_APP_BASE_URL}index.html;
    }
}
