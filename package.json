{
  "name": "kernel-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "audit": "node scripts/run-audit.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "check:snapshot": "node scripts/validate-bootstrap.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:coverage && npm run test:governance",
    "test:coverage": "vitest run --coverage",
    "test:governance": "node -e \"require('node:fs').mkdirSync('coverage/governance', { recursive: true })\" && node --experimental-test-coverage --test --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/governance/lcov.info scripts/check-pr-size.test.mjs scripts/check-ci.test.mjs scripts/validate-bootstrap.test.mjs scripts/boundaries.test.mjs scripts/validate.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "node scripts/validate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "^3.9.10",
    "semver": "7.8.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.5.11",
    "jalaliday": "^3.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.9"
  }
}
