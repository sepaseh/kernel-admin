{
  "name": "kernel-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "audit": "node scripts/run-audit.mjs",
    "browser:install": "playwright install --with-deps chromium",
    "browser:install:all": "playwright install --with-deps chromium firefox webkit",
    "build": "npm run check:production-env && npm run typecheck && vite build && node scripts/stamp-admin-build.mjs",
    "build-storybook": "storybook build --output-dir coverage/storybook-static",
    "build:verification": "node scripts/run-visual.mjs --build",
    "build:verification:assets": "npm run check:production-env && vite build && node scripts/stamp-admin-build.mjs",
    "check:actions": "node scripts/run-actionlint.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "check:guidance": "node scripts/check-guidance.mjs",
    "check:production-env": "node scripts/validate-production-env.mjs",
    "check:snapshot": "node scripts/validate-bootstrap.mjs",
    "check:unused": "knip",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "npm run test:coverage && npm run test:governance",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config playwright.config.ts --project=chromium",
    "test:e2e:complete": "playwright test --config playwright.config.ts",
    "test:governance": "node -e \"require('node:fs').mkdirSync('coverage/governance', { recursive: true })\" && node --experimental-test-coverage --test-coverage-exclude=**/*.test.* --test --test-concurrency=1 --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/governance/lcov.info scripts/block-dangerous.test.mjs scripts/post-edit-format.test.mjs scripts/quality-gate.test.mjs scripts/check-boundaries.test.mjs scripts/check-ci.test.mjs scripts/ci-evidence.test.mjs scripts/run-actionlint.test.mjs scripts/check-guidance.integration.test.mjs scripts/check-guidance.test.mjs scripts/dependency-compatibility.test.mjs scripts/deploy-runtime.test.mjs scripts/deployment.integration.test.mjs scripts/docker-smoke-resources.test.mjs scripts/test-docker-release.test.mjs scripts/package-release.test.mjs scripts/render-deployment.integration.test.mjs scripts/render-deployment.test.mjs scripts/healthcheck.test.mjs scripts/run-visual.integration.test.mjs scripts/run-visual.test.mjs scripts/validate-bootstrap.test.mjs scripts/validate-deployment-env.test.mjs scripts/validate.test.mjs scripts/visual-environment.test.mjs",
    "test:guidance": "node --test scripts/check-guidance.test.mjs scripts/check-guidance.integration.test.mjs scripts/block-dangerous.test.mjs scripts/post-edit-format.test.mjs scripts/quality-gate.test.mjs",
    "test:lighthouse": "npm run build && node scripts/run-lighthouse.mjs",
    "test:lighthouse:verified": "node scripts/run-visual.mjs --verify-build && node scripts/run-lighthouse.mjs",
    "test:mutation": "stryker run",
    "test:smoke": "playwright test --config smoke.config.ts",
    "test:staging": "playwright test --config staging.config.ts",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:visual": "node scripts/run-visual.mjs",
    "test:visual:update": "node scripts/run-visual.mjs --update",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "validate": "node scripts/validate.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "17.1.4",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/builder-vite": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@stryker-mutator/core": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "chrome-launcher": "1.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fontkit": "2.0.4",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "lighthouse": "13.6.0",
    "msw": "3.0.3",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "semver": "7.8.5",
    "storybook": "10.6.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "antd": "6.6.8",
    "antd-style": "4.1.0",
    "axios": "1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.5.12",
    "jalaliday": "^3.1.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "8.5.1",
    "web-vitals": "6.2.3"
  },
  "overrides": {
    "glob@13.0.6": "14.0.3",
    "minimatch@10.2.6": "11.0.3",
    "qs@6.15.1": "6.17.1"
  }
}
