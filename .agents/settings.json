{
  "name": "kernel-admin-application",
  "description": "Assistant-neutral guidance for the standalone admin application and its complete application verification.",
  "rules": [
    ".agents/rules/branches.md",
    ".agents/rules/code-quality.md",
    ".agents/rules/code-review.md",
    ".agents/rules/commits.md",
    ".agents/rules/git.md",
    ".agents/rules/guidance.md",
    ".agents/rules/issues.md",
    ".agents/rules/pull-requests.md",
    ".agents/rules/safety.md"
  ],
  "skills": [
    ".agents/skills/commit/SKILL.md",
    ".agents/skills/create-issue/SKILL.md",
    ".agents/skills/create-pr/SKILL.md",
    ".agents/skills/review-pr/SKILL.md",
    ".agents/skills/start-issue/SKILL.md",
    ".agents/skills/validate-change/SKILL.md"
  ],
  "optionalHooks": [
    ".agents/hooks/block-dangerous.mjs",
    ".agents/hooks/block-dangerous.sh",
    ".agents/hooks/post-edit-format.sh",
    ".agents/hooks/quality-gate.sh"
  ],
  "recommendedChecks": [
    "npm run check:snapshot",
    "npm run check:ci",
    "npm run check:guidance",
    "npm run audit",
    "npm run check:boundaries",
    "npm run typecheck",
    "npm run lint",
    "npm run format:check",
    "npm run test:coverage",
    "npm run test:governance"
  ],
  "navigation": ".agents/navigation.json",
  "validation": ".agents/validation.json",
  "evaluation": ".agents/evaluation/cases.json",
  "recommendedChecksSource": {
    "path": ".agents/validation.json",
    "profile": "full"
  },
  "entryPoints": ["AGENTS.md"],
  "adapters": []
}
