{
  "schemaVersion": 1,
  "tasks": [
    {
      "id": "http-contract",
      "when": "Change a request/response field, HTTP method, endpoint path or status.",
      "owners": [
        "src/features",
        "src/shared/api",
        "src/shared/contracts/index.ts"
      ],
      "contracts": [
        "src/shared/api/types.ts",
        "src/features/settings/types.ts",
        "docs/authentication.md"
      ],
      "tests": [
        "src/shared/api/client.test.ts",
        "src/features/settings/api.test.ts",
        "src/features/users/api.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "unit-coverage"],
      "rules": [".agents/rules/react.md", ".agents/rules/imports.md"],
      "limitations": "Synthetic consumer/transport tests establish local HTTP expectations; they do not verify a deployed backend. The consuming developer chooses a compatible implementation."
    },
    {
      "id": "auth-session",
      "when": "Trace login, refresh, logout, password changes or session cookie handling.",
      "owners": [
        "src/shared/api/client.ts",
        "src/shared/api/token.ts",
        "src/features/auth/api.ts"
      ],
      "contracts": ["src/features/auth/types.ts", "src/shared/api/types.ts"],
      "tests": [
        "src/shared/api/client.test.ts",
        "src/shared/api/token.test.ts",
        "src/features/auth/logout.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "unit-coverage"],
      "rules": [".agents/rules/react.md", ".agents/rules/imports.md"],
      "limitations": "Authentication execution and server-session revocation occur behind HTTP; client token clearing is not server revocation."
    },
    {
      "id": "active-language",
      "when": "Trace validated API language code/direction/calendar/names, fixed bootstrap, vendor adapters, calendar display or super-admin language changes.",
      "owners": [
        "src/app/providers/core/Core.tsx",
        "src/app/providers/antd/Antd.tsx",
        "src/features/calendar/Calendar.tsx",
        "src/shared/i18n/index.ts",
        "src/features/settings/Settings.tsx",
        "src/features/settings/api.ts",
        "src/shared/i18n/date.ts"
      ],
      "contracts": [
        "src/features/settings/types.ts",
        "src/shared/i18n/locales.ts",
        ".agents/rules/localization.md"
      ],
      "tests": [
        "src/app/providers/core/Core.test.tsx",
        "src/app/providers/antd/Antd.test.tsx",
        "src/features/calendar/Calendar.test.tsx",
        "src/features/settings/api.test.ts",
        "src/shared/i18n/index.test.ts",
        "src/features/settings/Settings.test.tsx",
        "src/shared/i18n/date.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "lint", "unit-coverage"],
      "rules": [
        ".agents/rules/localization.md",
        ".agents/rules/react.md",
        ".agents/rules/imports.md"
      ],
      "limitations": "Validated API metadata owns active language, direction, calendar and names. Local code maps select catalogs/vendor adapters only; toolbar choices are synthetic fixtures."
    },
    {
      "id": "shared-translation",
      "when": "Reuse or add a semantic UI meaning in all ten complete flat local catalogs.",
      "owners": [
        "src/shared/i18n/catalogs.ts",
        "src/shared/i18n/locales",
        "src/shared/i18n/locales.ts"
      ],
      "contracts": [
        "src/shared/i18n/locales.ts",
        ".agents/rules/localization.md"
      ],
      "tests": [
        "src/shared/i18n/catalogs.test.ts",
        "src/shared/i18n/index.test.ts",
        "src/shared/i18n/dayjs.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "unit-coverage"],
      "rules": [".agents/rules/localization.md", ".agents/rules/imports.md"],
      "limitations": "Runtime fallback does not excuse a missing translation; all catalog source and integrity evidence belong to this frontend."
    },
    {
      "id": "deployment-recovery",
      "when": "Plan future deployment/recovery work while preserving current publication boundaries.",
      "owners": [
        "docs/development.md",
        "docs/architecture.md",
        "docs/README.md"
      ],
      "contracts": ["docs/validation.md"],
      "tests": ["scripts/validate-bootstrap.test.mjs"],
      "checks": ["snapshot", "guidance", "format"],
      "rules": [".agents/rules/safety.md", ".agents/rules/guidance.md"],
      "limitations": "Published synthetic deployment and release helpers do not establish a production build, released artifact, deployed target or real recovery. Read the actual publication inventory and require explicit operational authorization."
    },
    {
      "id": "admin-request-reliability",
      "when": "Change cancellation, obsolete-read handling, manual retry/error states, timeouts, shared refresh, generation guards or logout completion.",
      "owners": [
        "src/shared/hooks/useReadRequest.ts",
        "src/shared/hooks/useReadResource.ts",
        "src/shared/api/client.ts",
        "src/shared/api/token.ts",
        "src/features/auth/api.ts",
        "src/app/providers/core/Core.tsx",
        "src/layouts/default/Default.tsx",
        "src/shared/ui/request-feedback/RequestFeedback.tsx"
      ],
      "contracts": ["docs/authentication.md"],
      "tests": [
        "src/shared/hooks/useReadResource.test.ts",
        "src/shared/api/client.test.ts",
        "src/layouts/default/Default.test.tsx",
        "src/features/auth/logout.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "lint", "unit-coverage"],
      "rules": [".agents/rules/react.md", ".agents/rules/imports.md"],
      "limitations": "Read retry is an explicit user action; one eligible protected-401 replay after successful same-generation refresh is a separate mechanism. Synthetic tests are not a real API/browser journey."
    },
    {
      "id": "guidance",
      "when": "Change assistant instructions, navigation, decision records, validation policy or evaluation cases.",
      "owners": [
        "AGENTS.md",
        ".agents",
        ".claude",
        "CLAUDE.md",
        "scripts/check-guidance.mjs"
      ],
      "contracts": [
        ".agents/validation.json",
        ".agents/settings.json",
        ".agents/navigation.json",
        "docs/validation.md"
      ],
      "tests": [
        "scripts/check-guidance.test.mjs",
        "scripts/block-dangerous.test.mjs",
        "scripts/post-edit-format.test.mjs",
        "scripts/quality-gate.test.mjs",
        "scripts/validate.test.mjs"
      ],
      "checks": ["guidance", "guidance-tests", "governance-coverage", "format"],
      "rules": [
        ".agents/rules/guidance.md",
        ".agents/rules/git.md",
        ".agents/rules/safety.md"
      ],
      "limitations": "Static inventory/link checks do not prove automatic host loading or improved assistant comprehension; optional Bash host prerequisites must be reported."
    },
    {
      "id": "publication-validation",
      "when": "Change published repository rules, review policy, CI or validation tooling.",
      "owners": [
        "scripts/check-ci.mjs",
        "scripts/validate-bootstrap.mjs",
        "scripts/check-guidance.mjs"
      ],
      "contracts": [
        ".github/bootstrap-policy.json",
        ".agents/validation.json",
        "package.json"
      ],
      "tests": [
        "scripts/check-ci.test.mjs",
        "scripts/validate-bootstrap.test.mjs",
        "scripts/check-guidance.test.mjs"
      ],
      "checks": [
        "snapshot",
        "ci-policy",
        "guidance",
        "boundaries",
        "typecheck",
        "lint",
        "unit-coverage",
        "governance-coverage"
      ],
      "rules": [".agents/rules/git.md", ".agents/rules/safety.md"],
      "limitations": "Only admitted source is verified. No application activation, external review, deployed target or provider compatibility follows from configuration alone."
    }
  ],
  "phase": "business-screens",
  "applicationReady": false
}
