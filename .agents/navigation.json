{
  "schemaVersion": 1,
  "tasks": [
    {
      "id": "publication-validation",
      "when": "Change published repository rules, review policy, CI or validation tooling.",
      "owners": [
        "scripts/check-ci.mjs",
        "scripts/run-actionlint.mjs",
        "scripts/ci-evidence.mjs",
        ".github/workflows/codeql.yml",
        "scripts/validate-bootstrap.mjs",
        "scripts/check-guidance.mjs"
      ],
      "contracts": [
        ".github/bootstrap-policy.json",
        ".agents/validation.json",
        "package.json"
      ],
      "tests": [
        "scripts/check-ci.test.mjs",
        "scripts/run-actionlint.test.mjs",
        "scripts/ci-evidence.test.mjs",
        "scripts/validate-bootstrap.test.mjs",
        "scripts/check-guidance.test.mjs"
      ],
      "checks": [
        "snapshot",
        "ci-policy",
        "actions-lint",
        "guidance",
        "boundaries",
        "typecheck",
        "lint",
        "unit-coverage",
        "governance-coverage"
      ],
      "rules": [".agents/rules/git.md", ".agents/rules/safety.md"],
      "limitations": "Only admitted source is verified. No application activation, external review, deployed target or provider compatibility follows from configuration alone."
    },
    {
      "id": "runtime-localization",
      "when": "Change admitted shared runtime helpers, language catalogs or date adapters.",
      "owners": [
        "src/shared/api/token.ts",
        "src/shared/config/language.ts",
        "src/shared/i18n/catalogs.ts",
        "src/shared/i18n/index.ts",
        "src/shared/i18n/date.ts",
        "src/shared/i18n/dayjs/fa.ts",
        "src/shared/lib/transform.ts",
        "src/shared/lib/error.ts",
        "src/shared/lib/color-contrast.ts"
      ],
      "contracts": [
        "src/shared/api/types.ts",
        "src/shared/contracts/index.ts",
        "src/shared/i18n/locales.ts",
        "docs/localization.md"
      ],
      "tests": [
        "src/shared/api/token.test.ts",
        "src/shared/config/language.test.ts",
        "src/shared/i18n/catalogs.test.ts",
        "src/shared/i18n/index.test.ts",
        "src/shared/i18n/date.test.ts",
        "src/shared/i18n/dayjs.test.ts",
        "src/shared/lib/transform.test.ts",
        "src/shared/lib/error.test.ts",
        "src/shared/lib/color-contrast.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "lint", "unit-coverage"],
      "rules": [".agents/rules/code-quality.md", ".agents/rules/safety.md"],
      "limitations": "Module tests do not establish an assembled application, HTTP integration, browser journeys or a production build. Preserve all ten catalogs, Persian date data and server-owned language, direction and calendar."
    }
  ],
  "phase": "runtime-localization",
  "applicationReady": false
}
